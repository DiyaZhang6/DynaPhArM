; nvt.mdp - used for NVT equilibration
; =======================================

define                  = -DPOSRES  ; position restrain the protein (and ligand if defined in index)
; Run parameters
integrator              = md        ; leap-frog integrator
nsteps                  = 50000     ; 2 fs * 50,000 steps = 100 ps
dt                      = 0.002     ; 2 fs
; Output control
nstxout-compressed      = 5000      ; save coordinates every 10 ps
nstlog                  = 5000      ; update log file every 10 ps
; Bond parameters
constraint_algorithm    = lincs     ; holonomic constraints
constraints             = h-bonds   ; all bonds involving H are constrained
; Neighborsearching
cutoff-scheme           = Verlet
ns_type                 = grid      
rcoulomb                = 1.0       
rvdw                    = 1.0       
; Electrostatics
coulombtype             = PME       
; Temperature coupling
tcoupl                  = V-rescale             ; modified Berendsen thermostat
tc-grps                 = Protein_UNL   Water_and_ions    ; couple protein-ligand and solvent-ions separately
tau_t                   = 0.1   0.1           ; time constant, in ps
ref_t                   = 300   300           ; reference temperature, in K
; Pressure coupling is off
pcoupl                  = no        
; Periodic boundary conditions
pbc                     = xyz       
; Velocity generation
gen_vel                 = yes       ; assign velocities from Maxwell distribution
gen_temp                = 300       ; temperature for Maxwell distribution
gen_seed                = -1        ; generate a random seed
