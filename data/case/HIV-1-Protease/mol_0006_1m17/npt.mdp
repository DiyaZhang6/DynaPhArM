; npt.mdp - used for NPT equilibration
; =======================================

define                  = -DPOSRES  ; position restrain the protein (and ligand if defined in index)
; Run parameters
integrator              = md        
nsteps                  = 50000     ; 2 fs * 50,000 steps = 100 ps
dt                      = 0.001     
; Output control
nstxout-compressed      = 5000      
nstlog                  = 5000      
; Bond parameters
continuation            = yes       ; continuing from NVT
constraint_algorithm    = lincs     
constraints             = h-bonds   
; Neighborsearching
cutoff-scheme           = Verlet
ns_type                 = grid      
rcoulomb                = 1.0       
rvdw                    = 1.0       
; Electrostatics
coulombtype             = PME       
; Temperature coupling
tcoupl                  = V-rescale             
tc-grps                 = Protein_UNL   Water_and_ions    
tau_t                   = 0.1   0.1           
ref_t                   = 300   300           
; Pressure coupling
pcoupl                  = Berendsen     ; precise pressure coupling
pcoupltype              = isotropic             ; uniform scaling of the box
tau_p                   = 2.0                   ; time constant, in ps
ref_p                   = 1.0                   ; reference pressure, in bar
compressibility         = 4.5e-5                ; isothermal compressibility of water
; Periodic boundary conditions
pbc                     = xyz       
; Velocity generation
gen_vel                 = no        ; velocities are continued from NVT run
